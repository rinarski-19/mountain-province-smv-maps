# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings > Environment Variables.
# Do not commit real keys or passwords.

# Public client-side flags/tokens. These are embedded in the browser bundle,
# so restrict Mapbox/Google keys to your allowed domains in their dashboards.
#
# NEXT_PUBLIC_READ_ONLY / NEXT_PUBLIC_WORKSPACE_MODE now control the
# PRESENTATION defaults only — which basemaps are offered and whether
# building footprints start on. They no longer decide who may edit:
# that is the password lock (SAVE_PASSWORD, below). A read-only public
# deployment opens locked, and anyone with the team password can unlock
# the editing and printing tools from the lock button in the top bar.
NEXT_PUBLIC_READ_ONLY=true
NEXT_PUBLIC_WORKSPACE_MODE=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# The shared team password. One secret gates everything:
#   - the frontend lock button (POST /api/auth/unlock sets an httpOnly
#     cookie that lasts 12 hours)
#   - every write route (zones, views, landmarks, roads, print settings),
#     which also still accept `Authorization: Bearer <SAVE_PASSWORD>`
# Unset on a deployed build = nobody can edit and the lock button says so.
# Unset in local development = editing is open, as it has always been.
SAVE_PASSWORD=

# Hard kill switch. With this set, no write succeeds and nothing can be
# unlocked, whatever password is presented. Reading and printing still work.
SMV_LOCKDOWN=

# Where deployed saves are committed. Required only when editing is
# enabled on a deployed build; local development writes straight to
# public/data/ instead.
GITHUB_TOKEN=
GITHUB_OWNER=rinarski-19
GITHUB_REPO=mountain-province-smv-maps
GITHUB_BRANCH=main

# Local tile download scripts only. Do not expose this through NEXT_PUBLIC_.
MAPBOX_TOKEN=
