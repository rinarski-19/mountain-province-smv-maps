# Offline OSM tile pack — hundreds of MB, generated per-machine via
# `npm run tiles:bauko` / `npm run tiles:barlig` etc. Cloned repo
# defaults to Online mode, so missing tiles never break the app.
public/tiles/
public/tiles-mapbox-hidpi/

# Generated print map exports. `npm run build` regenerates these via prebuild.
public/print/**/*.svg

# Build/cache artifacts that don't belong in version control.
*.tsbuildinfo
.vercel/
